# Engine daemon local data - Steam refresh tokens (bearer credentials) live here.
# The real store is per-user OS app-data (outside the repo); these guard any
# stray local copy from ever being committed.
engine-data/
**/steam-tokens.json
**/steam-tokens.json.tmp
**/account.config
downloads/.credentials/

# Engine daemon sidecar binaries (81MB each) - built via scripts/build-engine-host.ps1,
# not committed (like the fork's DepotDownloader sidecars).
src-tauri/binaries/*/OmniPackerEngine
src-tauri/binaries/*/OmniPackerEngine.exe
